# ==============================================================
# CẤU HÌNH HỆ THỐNG FASTAPI & MYSQL (BACKEND STORE MANAGEMENT)
# ==============================================================

# Thông tin Ứng dụng
PROJECT_NAME="Hybrid Store E-Commerce Platform"
API_V1_STR="/api/v1"
SECRET_KEY="hybrid-store-jwt-secret-key-change-in-production"
DEBUG=True

# Cấu hình Máy chủ Web
HOST="0.0.0.0"
PORT=8000

# ==============================================================
# THÔNG TIN KẾT NỐI MYSQL DATABASE (PYMYSQL DRIVER)
# ==============================================================
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD=""
DB_NAME="hybrid_store_db"

# Chuỗi kết nối trực tiếp (nếu có giá trị này, hệ thống sẽ ưu tiên dùng):
# DATABASE_URL="mysql+pymysql://root:@localhost:3306/hybrid_store_db?charset=utf8mb4"

# Tự động Fallback sang SQLite nội bộ nếu MySQL cục bộ chưa khởi động:
USE_SQLITE_FALLBACK=True
